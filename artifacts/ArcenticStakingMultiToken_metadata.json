		"devdoc": {
			"details": "IMPORTANT SECURITY NOTE: staking is only possible for tokens the owner has      explicitly whitelisted with addToken(). This is intentional — allowing      permissionless staking of arbitrary tokens would let anyone break pool      accounting with fee-on-transfer, rebasing, or reentrant (ERC-777 style)      tokens. Only whitelist standard, audited, non-rebasing ERC-20s.",
			"errors": {
				"AddressEmptyCode(address)": [
					{
						"details": "There's no code at `target` (it is not a contract)."
					}
				],
				"AddressInsufficientBalance(address)": [
					{
						"details": "The ETH balance of the account is not enough to perform the operation."
					}
				],
				"EnforcedPause()": [
					{
						"details": "The operation failed because the contract is paused."
					}
				],
				"ExpectedPause()": [
					{
						"details": "The operation failed because the contract is not paused."
					}
				],
				"FailedInnerCall()": [
					{
						"details": "A call to an address target failed. The target may have reverted."
					}
				],
				"OwnableInvalidOwner(address)": [
					{
						"details": "The owner is not a valid owner account. (eg. `address(0)`)"
					}
				],
				"OwnableUnauthorizedAccount(address)": [
					{
						"details": "The caller account is not authorized to perform an operation."
					}
				],
				"ReentrancyGuardReentrantCall()": [
					{
						"details": "Unauthorized reentrant call."
					}
				],
				"SafeERC20FailedOperation(address)": [
					{
						"details": "An operation with an ERC20 token failed."
					}
				]
			},
			"events": {
				"Paused(address)": {
					"details": "Emitted when the pause is triggered by `account`."
				},
				"Unpaused(address)": {
					"details": "Emitted when the pause is lifted by `account`."
				}
			},
			"kind": "dev",
			"methods": {
				"owner()": {
					"details": "Returns the address of the current owner."
				},
				"paused()": {
					"details": "Returns true if the contract is paused, and false otherwise."
				},
				"renounceOwnership()": {
					"details": "Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner."
				},
				"transferOwnership(address)": {
					"details": "Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner."
				}
			},
			"stateVariables": {
				"earlyExitPenaltyBps": {
					"details": "Applies uniformly across all tokens for simplicity/predictability."
				}
			},
			"title": "ArcenticStakingMultiToken",
			"version": 1
		},
		"userdoc": {
			"kind": "user",
			"methods": {
				"addToken(address)": {
					"notice": "Whitelist a new ERC-20 token for staking. Reverts if already added."
				},
				"claimReward(uint256)": {
					"notice": "Claim accrued rewards without unstaking the principal."
				},
				"earlyExitPenaltyBps()": {
					"notice": "Penalty (in bps of principal) charged on emergency (pre-unlock) withdrawals."
				},
				"emergencyUnstake(uint256)": {
					"notice": "Exit before the lock expires. Forfeits all accrued/reserved reward for this         stake and may incur an owner-configured penalty (in bps of principal) that         goes to the treasury. Reserved reward is returned to that token's pool."
				},
				"fundRewards(address,uint256)": {
					"notice": "Fund a token's reward pool. Anyone may top it up, but only the owner         should normally need to. Uses the actual received amount (post-transfer         balance delta) so fee-on-transfer tokens can't silently over-credit."
				},
				"pendingReward(address,uint256)": {
					"notice": "Reward accrued so far for a stake (linear, capped at the stake's lock         duration), minus whatever has already been claimed."
				},
				"setTier(address,uint256,uint256,bool)": {
					"notice": "Update APR and/or active flag for a tier. Only affects *future* stakes;         existing stakes keep the APR/lock they were opened with."
				},
				"setTokenSupported(address,bool)": {
					"notice": "Toggle whether new stakes/reward funding are accepted for a token.         Existing stakes remain claimable/unstakeable regardless of this flag."
				},
				"supportedTokensLength()": {
					"notice": "Number of tokens ever added via addToken(). Some may currently have         supported == false — check tokenSupported() before offering new stakes."
				},
				"treasury()": {
					"notice": "Where early-unstake penalties are sent. Defaults to the deployer."
				},
				"unstake(uint256)": {
					"notice": "Withdraw principal + any remaining accrued reward once the lock has expired."
				},
				"withdrawUnreservedRewards(address,uint256)": {
					"notice": "Owner can reclaim reward tokens that are sitting uncommitted (not reserved         against any open stake). Cannot touch reserved rewards or staker principal."
				}
			},
			"notice": "True multi-token staking: the owner whitelists any number of ERC-20 tokens,         each with its own independent set of fixed-duration / fixed-APR lock tiers.         Stakers pick a token AND a tier; rewards are paid in the SAME token that was         staked (no cross-token exchange-rate risk) and are pre-reserved from a         per-token, owner-funded reward pool at stake time.",
			"version": 1
		}
	},
